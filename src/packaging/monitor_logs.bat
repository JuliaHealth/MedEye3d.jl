@echo off
title MedEye3D Live Log Monitor
powershell.exe -NoExit -ExecutionPolicy Bypass -Command "Write-Host '===================================================' -ForegroundColor Cyan; Write-Host '           MedEye3D Live Log Monitor               ' -ForegroundColor Cyan; Write-Host '===================================================' -ForegroundColor Cyan; Write-Host 'Watching log file: ' -NoNewline; Write-Host $env:APPDATA\MedEye3D\logs\medeye3d_output.log -ForegroundColor Yellow; Write-Host 'Press Ctrl+C to stop monitoring.' -ForegroundColor Gray; Write-Host ''; if (Test-Path $env:APPDATA\MedEye3D\logs\medeye3d_output.log) { Get-Content -Path $env:APPDATA\MedEye3D\logs\medeye3d_output.log -Wait -Tail 40 } else { Write-Host 'Waiting for MedEye3D to launch and create logs...' -ForegroundColor Yellow; while (-not (Test-Path $env:APPDATA\MedEye3D\logs\medeye3d_output.log)) { Start-Sleep -Milliseconds 500 }; Get-Content -Path $env:APPDATA\MedEye3D\logs\medeye3d_output.log -Wait -Tail 40 }"
