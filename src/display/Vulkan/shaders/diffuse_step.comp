#version 450
// diffuse_step.comp — Single explicit Euler step of 3D inhomogeneous heat diffusion
// Implements: u_new = u + dt * sum_d [ D_face_d * (u_neighbor - u_center) ]
// Uses replicate (clamped) boundary conditions for zero normal flux.
// This shader is dispatched K times, ping-ponging between img_u_in and img_u_out.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(set = 0, binding = 0, r32f) uniform readonly image3D img_D;     // Precomputed diffusivity
layout(set = 0, binding = 1, r32f) uniform readonly image3D img_u_in;  // Current heat field
layout(set = 0, binding = 2, r32f) uniform writeonly image3D img_u_out; // Next heat field

layout(push_constant) uniform PushConstants {
    float dt;         // Time step size (0.16)
    int   use_box;    // 0 = full volume, 1 = use box_min and box_max
    int   seed_x;
    int   seed_y;
    ivec4 box_min;    // xyz = min bounding box voxel, w = seed_z
    ivec4 box_max;    // xyz = max bounding box voxel, w = seed_radius
    vec4  inv_d2;     // xyz = 1/(dx²), 1/(dy²), 1/(dz²) normalized, w = unused
} pc;

void main() {
    ivec3 dims = imageSize(img_u_in);
    ivec3 pos;
    if (pc.use_box == 1) {
        pos = pc.box_min.xyz + ivec3(gl_GlobalInvocationID.xyz);
        if (any(greaterThan(pos, pc.box_max.xyz))) return;
    } else {
        pos = ivec3(gl_GlobalInvocationID.xyz);
    }
    if (any(greaterThanEqual(pos, dims))) return;
    if (any(lessThan(pos, ivec3(0)))) return;

    ivec3 maxCoord = dims - ivec3(1);

    // Replicate-padded neighbor coordinates (Neumann zero-flux BC)
    ivec3 p_xp = ivec3(min(pos.x + 1, maxCoord.x), pos.y, pos.z);
    ivec3 p_xm = ivec3(max(pos.x - 1, 0),          pos.y, pos.z);
    ivec3 p_yp = ivec3(pos.x, min(pos.y + 1, maxCoord.y), pos.z);
    ivec3 p_ym = ivec3(pos.x, max(pos.y - 1, 0),          pos.z);
    ivec3 p_zp = ivec3(pos.x, pos.y, min(pos.z + 1, maxCoord.z));
    ivec3 p_zm = ivec3(pos.x, pos.y, max(pos.z - 1, 0));

    // Load center values
    float u_c = imageLoad(img_u_in, pos).r;
    float D_c = imageLoad(img_D, pos).r;

    // Shape-adaptive heat-level transition:
    // Core (u >= u_core) maintains s = 1.0 (free internal flow)
    // Advancing frontier (u < u_core) blends to boosted s
    float s_boost = (pc.inv_d2.w > 0.05) ? pc.inv_d2.w : 1.0;
    float s_eff = 1.0;
    if (abs(s_boost - 1.0) > 0.01) {
        float u_core = 0.05;
        float u_floor = 0.001; // commit threshold theta
        float w_u = clamp((u_core - u_c) / max(u_core - u_floor, 1e-5), 0.0, 1.0);
        s_eff = 1.0 + (s_boost - 1.0) * w_u;
        D_c = clamp(pow(D_c, s_eff), 1.0e-5, 1.0);
    }

    // Load neighbor heat values
    float u_xp = imageLoad(img_u_in, p_xp).r;
    float u_xm = imageLoad(img_u_in, p_xm).r;
    float u_yp = imageLoad(img_u_in, p_yp).r;
    float u_ym = imageLoad(img_u_in, p_ym).r;
    float u_zp = imageLoad(img_u_in, p_zp).r;
    float u_zm = imageLoad(img_u_in, p_zm).r;

    // Load neighbor diffusivities and apply effective exponent if active
    float D_xp_raw = imageLoad(img_D, p_xp).r;
    float D_xm_raw = imageLoad(img_D, p_xm).r;
    float D_yp_raw = imageLoad(img_D, p_yp).r;
    float D_ym_raw = imageLoad(img_D, p_ym).r;
    float D_zp_raw = imageLoad(img_D, p_zp).r;
    float D_zm_raw = imageLoad(img_D, p_zm).r;

    if (abs(s_eff - 1.0) > 0.01) {
        D_xp_raw = clamp(pow(D_xp_raw, s_eff), 1.0e-5, 1.0);
        D_xm_raw = clamp(pow(D_xm_raw, s_eff), 1.0e-5, 1.0);
        D_yp_raw = clamp(pow(D_yp_raw, s_eff), 1.0e-5, 1.0);
        D_ym_raw = clamp(pow(D_ym_raw, s_eff), 1.0e-5, 1.0);
        D_zp_raw = clamp(pow(D_zp_raw, s_eff), 1.0e-5, 1.0);
        D_zm_raw = clamp(pow(D_zm_raw, s_eff), 1.0e-5, 1.0);
    }

    // Face-averaged conductivities (arithmetic mean of adjacent voxels)
    float D_xp = 0.5 * (D_c + D_xp_raw);
    float D_xm = 0.5 * (D_c + D_xm_raw);
    float D_yp = 0.5 * (D_c + D_yp_raw);
    float D_ym = 0.5 * (D_c + D_ym_raw);
    float D_zp = 0.5 * (D_c + D_zp_raw);
    float D_zm = 0.5 * (D_c + D_zm_raw);

    // Net flux divergence weighted by anisotropic voxel spacing (w_x = 1/dx^2, etc.)
    float wx = pc.inv_d2.x;
    float wy = pc.inv_d2.y;
    float wz = pc.inv_d2.z;
    float flux = wx * (D_xp * (u_xp - u_c) + D_xm * (u_xm - u_c))
               + wy * (D_yp * (u_yp - u_c) + D_ym * (u_ym - u_c))
               + wz * (D_zp * (u_zp - u_c) + D_zm * (u_zm - u_c));

    // Explicit Euler update
    float u_next = u_c + pc.dt * flux;

    // Continuous heat source: keep seed region at 1.0 (scaled to physical distance)
    float r = float(pc.box_max.w);
    if (r > 0.0) {
        vec3 diff = (vec3(pos) - vec3(pc.seed_x, pc.seed_y, pc.box_min.w)) * inversesqrt(max(pc.inv_d2.xyz, vec3(1e-6)));
        if (length(diff) <= max(r, 0.5)) {
            u_next = 1.0;
        }
    }

    imageStore(img_u_out, pos, vec4(u_next, 0.0, 0.0, 0.0));
}
