#version 450
// gaussian_smooth.comp — 3-pass separable 3D Gaussian edge smoothing & gap bridging
// Pass 0 (axis=0, X): reads raw diffusivity D_raw from img_in, converts to E_raw = -ln(D_raw)/gamma,
//                     applies 1D Gaussian along X, writes E_x to img_out.
// Pass 1 (axis=1, Y): reads E_x from img_in, applies 1D Gaussian along Y, writes E_xy to img_out.
// Pass 2 (axis=2, Z): reads E_xy from img_in and D_raw from img_raw, applies 1D Gaussian along Z
//                     to get E_smooth, bridges gaps while preserving sharp wall peaks, and converts
//                     back to D_smooth = eps_D + (1 - eps_D) * exp(-gamma * E_eff) into img_out.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(set = 0, binding = 0, r32f) uniform readonly image3D img_in;
layout(set = 0, binding = 1, r32f) uniform writeonly image3D img_out;
layout(set = 0, binding = 2, r32f) uniform readonly image3D img_raw;

layout(push_constant) uniform PushConstants {
    int   axis;        // 0 = X pass, 1 = Y pass, 2 = Z pass
    int   radius;      // Kernel radius in voxels: ceil(3 * sigma), clamped to [1, 9]
    float sigma;       // Gaussian standard deviation in voxels
    float gamma;       // 10.095886
    float epsilon_D;   // 1.0e-5
    float _pad0;
    float _pad1;
    float _pad2;
} pc;

float raw_D_to_E(float d_val, float inv_gamma) {
    return -log(clamp(d_val, 1.0e-5, 1.0)) * inv_gamma;
}

void main() {
    ivec3 pos = ivec3(gl_GlobalInvocationID.xyz);
    ivec3 dims = imageSize(img_in);
    if (any(greaterThanEqual(pos, dims))) return;

    float sigma = max(pc.sigma, 1.0e-4);
    int r = clamp(pc.radius, 0, 9);
    float inv_gamma = 1.0 / max(pc.gamma, 1.0e-4);

    if (r <= 0 || pc.sigma <= 0.01) {
        if (pc.axis == 2) {
            float d_raw = imageLoad(img_raw, pos).r;
            imageStore(img_out, pos, vec4(d_raw, 0.0, 0.0, 0.0));
        } else if (pc.axis == 0) {
            float d_raw = imageLoad(img_in, pos).r;
            imageStore(img_out, pos, vec4(raw_D_to_E(d_raw, inv_gamma), 0.0, 0.0, 0.0));
        } else {
            imageStore(img_out, pos, imageLoad(img_in, pos));
        }
        return;
    }

    float inv_2sigma2 = 0.5 / (sigma * sigma);
    float sum_val = 0.0;
    float sum_w = 0.0;

    for (int k = -r; k <= r; ++k) {
        ivec3 npos = pos;
        if (pc.axis == 0) {
            npos.x = clamp(pos.x + k, 0, dims.x - 1);
        } else if (pc.axis == 1) {
            npos.y = clamp(pos.y + k, 0, dims.y - 1);
        } else {
            npos.z = clamp(pos.z + k, 0, dims.z - 1);
        }

        float w = exp(-float(k * k) * inv_2sigma2);
        float v = imageLoad(img_in, npos).r;
        if (pc.axis == 0) {
            v = raw_D_to_E(v, inv_gamma);
        }
        sum_val += w * v;
        sum_w += w;
    }

    float e_smooth = sum_val / max(sum_w, 1.0e-6);

    if (pc.axis < 2) {
        imageStore(img_out, pos, vec4(e_smooth, 0.0, 0.0, 0.0));
    } else {
        // Pass 2 (Z): combine E_smooth with E_raw so 1-3 voxel gaps in edges gain strong
        // bridged edge energy while intact thin walls preserve their peak height.
        float d_raw = imageLoad(img_raw, pos).r;
        float e_raw = raw_D_to_E(d_raw, inv_gamma);
        float gain = 1.0 + 0.35 * sigma;
        float e_bridged = max(e_raw, gain * e_smooth);
        float e_eff = clamp(mix(e_smooth, e_bridged, 0.78), 0.0, 1.15);
        float d_out = clamp(pc.epsilon_D + (1.0 - pc.epsilon_D) * exp(-pc.gamma * e_eff), pc.epsilon_D, 1.0);
        imageStore(img_out, pos, vec4(d_out, 0.0, 0.0, 0.0));
    }
}
