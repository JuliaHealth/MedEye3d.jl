                50
            ]
        },
        "depends_on": [
            "helper_sternum_dilated_5mm",
            "helper_Lung_Stomach_Hull_Left",
            "Thoracic_Station_Hilar_Interlobar",
            "Abdominal_Station_16a1_Aortic_Hiatus",
