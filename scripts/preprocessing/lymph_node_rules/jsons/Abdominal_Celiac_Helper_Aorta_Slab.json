            },
            {
                "type": "VolumeIntersection",
                "target": "pancreas",
                "expected": 0
            },
            {
                "type": "VolumeIntersection",
                "target": "aorta",
                "expected": 0
            },
            {
                "type": "VolumeIntersection",
                "target": "liver",
                "expected": 0
            },
            {
                "type": "RelativePosition",
                "target": "celiac_inf_plane",
                "direction": "superior"
            },
            {
                "type": "RelativePosition",
                "target": "P_sma",
                "direction": "superior"
            },
            {
                "type": "RelativePosition",
                "target": "vertebrae_T10_min",
                "direction": "inferior"
            },
            {
                "type": "RelativePosition",
                "target": "vertebrae_L2_max",
