{
    "Thoracic_Mammary": {
        "rule": "AnisotropicMargin",
        "base_landmark": "sternum",
        "margins_mm": {
            "anterior": 30,
            "posterior": 0,
            "left": 100,
            "right": 100
        },
        "constraints": [
            {
                "constraint_type": "AnteriorTo",
                "landmarks": [
                    "sternum"
                ],
                "boundary_part": "max",
                "slice_wise": true,
                "comments": "Must be anterior to posterior edge (max Y) of sternum on each slice"
            },
            {
                "constraint_type": "AnteriorTo",
                "landmarks": [
                    "lungs"
                ],
                "boundary_part": "min",
                "slice_wise": true,
                "comments": "Must be anterior to anterior edge (min Y) of lungs on each slice"
            },
            {
                "constraint_type": "AnteriorTo",
                "landmarks": [
                    "heart"
                ],
                "boundary_part": "min",
                "slice_wise": true,
                "comments": "Must be anterior to anterior edge (min Y) of heart on each slice"
            }
        ],
        "z_plane_restriction": {
            "superior": "sternum",
            "superior_part": "max",
            "superior_offset_mm": 0,
            "inferior": "sternum",
            "inferior_part": "min"
        },
        "comments": "Internal Mammary. Strictly subcutaneous (anterior to chest wall). Excludes heart, vessels, lungs, and gives precedence to Prepericardial.",
        "ignore_global_exclusion": true,
        "ignore_fat": true,
        "after": [
            "Thoracic_Prepericardial",
            "Thoracic_Station_3A_Prevascular",
            "Thoracic_Station_6_Paraaortic",
            "Thoracic_Station_3P_Retrotracheal"
        ],
        "exclude": [
            "chest_wall",
            "lungs",
            "heart",
            "aorta",
            "lung_vessels",
            "superior_vena_cava",
            "inferior_vena_cava",
            "esophagus",
            "pulmonary_vein",
            "pulmonary_artery",
            "Thoracic_Prepericardial",
            "Thoracic_Station_3A_Prevascular",
            "Thoracic_Station_6_Paraaortic"
        ],
        "overlap_precedence": [],
        "keep_all_components": false,
        "ancillary_landmarks": [
            "Thoracic_Prepericardial",
            "Thoracic_Station_3A_Prevascular",
            "Thoracic_Station_6_Paraaortic",
            "aorta",
            "chest_wall",
            "esophagus",
            "heart",
            "inferior_vena_cava",
            "lung_vessels",
            "lungs",
            "pulmonary_artery",
            "pulmonary_vein",
            "sternum",
            "superior_vena_cava"
        ],
        "roi": {
            "landmark": "sternum",
            "padding_mm": [
                50,
                50,
                50
            ]
        }
    }
}