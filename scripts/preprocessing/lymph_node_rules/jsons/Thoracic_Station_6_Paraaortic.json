{
    "Thoracic_Station_6_Paraaortic": {
        "rule": "ConvexHull2D",
        "category": "Lymph_Node",
        "targets": [
            "lung_left",
            "aortic_arch_computed"
        ],
        "is_bilateral": false,
        "constraints": [
            {
                "constraint_type": "LineLimitBetweenLandmarks",
                "landmark_1": "aorta_ascending",
                "landmark_2": "aorta_descending",
                "label_value": 2,
                "comment": "Keep Lateral (Left) side of asc-desc aorta centerline — Station 6 is between arch and left lung"
            }
        ],
        "overlap_precedence": [
            "Thoracic_Station_Prepericardial_Left",
            "Thoracic_Station_Prepericardial_Right"
        ],
        "exclude": [
            "aorta",
            "aortic_arch_computed",
            "lung_left",
            "pulmonary_artery",
            "sternum",
            "trachea",
            "superior_vena_cava",
            "helper_pleural_space_left",
            "helper_pleural_space_right"
        ],
        "ignore_global_exclusion": true,
        "ignore_fat": true,
        "dependencies": [
            "lung_left",
            "aortic_arch_computed"
        ],
        "z_plane_restriction": {
            "superior": "aortic_arch_exported",
            "inferior": "aortic_arch_exported"
        },
        "per_slice_lcc": true
    }
}