{
    "Neck_Retrostyloid": {
        "rule": "DilatedMask",
        "is_bilateral": true,
        "input_landmarks": ["internal_carotid_artery", "common_carotid_artery"],
        "dilation_mm": 15.0,
        "constraints": [
            {
                "constraint_type": "AnteriorTo",
                "landmark": "fused_spine",
                "boundary_part": "min",
                "comment": "Posterior limit"
            }
        ],
        "exclude": [
            "skull",
            "parotid_gland",
            "pharynx",
            "internal_carotid_artery",
            "internal_jugular_vein",
            "common_carotid_artery"
        ],
        "assertions": [
            { "type": "VolumeMin", "value": 5 },
            { "type": "VolumeIntersection", "target": "internal_carotid_artery", "expected": 0 },
            { "type": "VolumeIntersection", "target": "internal_jugular_vein", "expected": 0 },
            { "type": "VolumeIntersection", "target": "parotid_gland", "expected": 0 },
            { "type": "VolumeIntersection", "target": "fused_spine", "expected": 500 },
            { "type": "RelativePosition", "target": "fused_spine", "direction": "anterior" }
        ],
        "keep_all_components": false,
        "ignore_global_exclusion": true,
        "ignore_fat": true,
        "comments": "Neck Level VIIB (Retrostyloid): 15mm expansion around ICA, constrained.",
        "ancillary_landmarks": [
            "internal_carotid_artery",
            "internal_jugular_vein",
            "fused_spine",
            "parotid_gland",
            "pharynx",
            "skull"
        ],
        "roi": {
            "landmark": "internal_carotid_artery",
            "padding_mm": [30, 30, 30]
        }
    }
}
